{% extends '@Forumify/frontend/base.html.twig' %}
{% block title_page %}{{ 'plugin_skeleton.title'|trans }}{% endblock %}
{% block body %}
    <h1>{{ 'plugin_skeleton.title'|trans }}</h1>
    <div class="box">
        <p>{{ 'plugin_skeleton.intro'|trans }}</p>

        {# skeleton:if entities #}
        <ul>
            {% for example in examples %}
                <li>{{ example.title }}</li>
            {% else %}
                <li>{{ 'plugin_skeleton.empty'|trans }}</li>
            {% endfor %}
        </ul>
        {# skeleton:endif #}
    </div>
{% endblock %}
